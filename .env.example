# ==============================================================================
# Momentum Backend - Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env before starting the server:
# cp .env.example .env
# ==============================================================================
#
# On AWS these values are injected by ECS task definitions from SSM Parameter
# Store (aws_requirements.md Stage C). `.env` is dev-only and never committed.

# Application & Security Settings
APP_ENV=development              # development | staging | production
SECRET_KEY=super-secret-key-change-in-production-12345
FRONTEND_URL=http://localhost:3000

# Task execution mode: "celery" (AWS) | "background" (local dev fallback)
TASK_MODE=celery
LOG_LEVEL=INFO

# Database Connection (PostgreSQL or SQLite)
# For local PostgreSQL (default on Linux/Ubuntu setup):
DATABASE_URL=postgresql://postgres:admin123@localhost:5432/primary_assessment
# For fast zero-setup SQLite fallback:
# DATABASE_URL=sqlite:///./sql_app.db

# Generative AI Engines & Models API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Redis & Celery Message Broker
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# SendGrid Email Notification Settings
SENDGRID_API_KEY=your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=unnati.study01@gmail.com
SKIP_EMAIL=true

# Object Storage (MediaStore). PAUSE_S3=true writes locally (dev only).
# In staging/production set PAUSE_S3=false; the ECS task role provides credentials,
# so AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY are NOT required there.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_STORAGE_BUCKET_NAME=student-assessment-pictures-primary
S3_BUCKET_MEDIA=momentum-media
S3_BUCKET_REPORTS=momentum-reports
PAUSE_S3=true
MEDIA_PRESIGN_EXPIRY_SECONDS=604800

# Local AI Speech & Audio Processing (Optional for local oral assessment testing)
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
KOKORO_BASE_URL=http://localhost:8880/v1

# ── ai_interview module (new, non-breaking) ──────────────────────────────
# Fail-closed interview engine + real cloud speech.
# LLM used for intent classification (gemini | groq).
AI_INTERVIEW_LLM_PROVIDER=gemini
# Cloud STT provider (groq) — uses GROQ_API_KEY above.
AI_INTERVIEW_STT_PROVIDER=groq
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_BASE_URL=https://api.groq.com/openai/v1
# Cloud TTS provider (elevenlabs | kokoro). ELEVENLABS_API_KEY required for elevenlabs.
AI_INTERVIEW_TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE=pNInz6obpgDQGcFmaJgB
# Engine tunables
AI_INTERVIEW_HINTS_LIMIT=2
AI_INTERVIEW_SILENCE_NUDGES_LIMIT=3
AI_INTERVIEW_TRIGGER_EVALUATION=true
# Pydantic AI agent model routing (groq | gemini). Reuses GROQ_API_KEY / GEMINI_API_KEY.
AI_INTERVIEW_MODEL_PROVIDER=groq
AI_INTERVIEW_GROQ_MODEL=llama-3.3-70b-versatile
AI_INTERVIEW_GEMINI_MODEL=gemini-2.0-flash
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
